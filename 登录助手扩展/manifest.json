{
  "manifest_version": 3,
  "name": "拼多多登录助手",
  "version": "1.0.0",
  "description": "自动打开拼多多移动端登录页，用户完成登录后自动提取 PDDAccessToken 与多多号，供订单导出工具使用。",
  "permissions": ["cookies", "tabs", "storage"],
  "host_permissions": [
    "*://*.yangkeduo.com/*",
    "*://*.pinduoduo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "拼多多登录助手"
  }
}
